@page "/reports"
@attribute [Authorize]

<PageTitle>Reports</PageTitle>

<h1 class="brand-header">Reports</h1>

<div class="filter-row">
    <div class="mb-3">
        <label>Status</label>
        <select class="form-control" @bind="_status">
            <option value="@AllOption">All</option>
            @foreach (var status in TicketConstants.Statuses)
            {
                <option value="@status">@status</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Priority</label>
        <select class="form-control" @bind="_priority">
            <option value="@AllOption">All</option>
            @foreach (var priority in TicketConstants.Priorities)
            {
                <option value="@priority">@priority</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label>Category</label>
        <select class="form-control" @bind="_category">
            <option value="@AllOption">All</option>
            @foreach (var category in TicketConstants.Categories)
            {
                <option value="@category">@category</option>
            }
        </select>
    </div>
</div>

<div class="filter-row">
    <div class="mb-3">
        <label>Created from</label>
        <InputDate class="form-control" @bind-Value="_dateFrom" />
    </div>
    <div class="mb-3">
        <label>Created to</label>
        <InputDate class="form-control" @bind-Value="_dateTo" />
    </div>
</div>

<div class="mb-3">
    <label>Search title/description</label>
    <input class="form-control" @bind="_search" @bind:event="oninput" />
</div>

<button class="btn btn-primary" @onclick="LoadAsync">Apply filters</button>

@if (_tickets is not null)
{
    <p>@_tickets.Count ticket(s) match the current filters.</p>

    <div class="quick-actions">
        <button class="btn btn-primary" @onclick="DownloadCsvAsync">Download CSV</button>
        <button class="btn btn-primary" @onclick="DownloadPdfAsync">Download PDF</button>
    </div>
}

@code {
    private const string AllOption = "All";

    [Inject]
    private IDbConnectionFactory ConnectionFactory { get; set; } = default!;

    [Inject]
    private TicketService TicketService { get; set; } = default!;

    [Inject]
    private ReportService ReportService { get; set; } = default!;

    [Inject]
    private CurrentUserAccessor CurrentUser { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private string _status = AllOption;
    private string _priority = AllOption;
    private string _category = AllOption;
    private DateOnly? _dateFrom;
    private DateOnly? _dateTo;
    private string _search = "";
    private IReadOnlyList<Ticket>? _tickets;

    protected override Task OnInitializedAsync() => LoadAsync();

    private TicketListFilter BuildFilter() => new()
    {
        UserId = CurrentUser.CurrentUser!.Id,
        Status = _status == AllOption ? null : _status,
        Priority = _priority == AllOption ? null : _priority,
        Category = _category == AllOption ? null : _category,
        DateFrom = _dateFrom,
        DateTo = _dateTo,
        Search = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
    };

    private async Task LoadAsync()
    {
        using var connection = ConnectionFactory.CreateConnection();
        _tickets = await TicketService.ListTicketsAsync(connection, BuildFilter());
    }

    private async Task DownloadCsvAsync()
    {
        var bytes = ReportService.GenerateCsv(_tickets!, CurrentUser.CurrentUser!.Id);
        await JS.InvokeVoidAsync("downloadFileFromBytes", "tickets.csv", "text/csv", Convert.ToBase64String(bytes));
    }

    private async Task DownloadPdfAsync()
    {
        var bytes = ReportService.GeneratePdf(_tickets!, CurrentUser.CurrentUser!.Id);
        await JS.InvokeVoidAsync("downloadFileFromBytes", "tickets.pdf", "application/pdf", Convert.ToBase64String(bytes));
    }
}
